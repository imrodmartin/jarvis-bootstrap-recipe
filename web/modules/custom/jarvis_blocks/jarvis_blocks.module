<?php

/**
 * @file
 * Renders Jarvis content block types through their matching SDCs.
 *
 * A single preprocess hook covers both Layout Builder inline blocks and
 * Block-layout placed content blocks: both return the block_content entity
 * view build, so #block_content is present on $variables['content'].
 */

declare(strict_types=1);

use Drupal\Core\Cache\CacheableMetadata;
use Drupal\block_content\BlockContentInterface;

/**
 * Maps block_content bundle => SDC component id.
 */
function _jarvis_blocks_map(): array {
  return [
    'hero' => 'jarvis:hero',
    'card' => 'jarvis:card',
    'video' => 'jarvis:video',
    'image' => 'jarvis:image',
    'text' => 'jarvis:text',
  ];
}

/**
 * Implements hook_preprocess_HOOK() for block.
 */
function jarvis_blocks_preprocess_block(array &$variables): void {
  $content = $variables['content'] ?? [];
  $bc = $content['#block_content'] ?? NULL;
  if (!$bc instanceof BlockContentInterface) {
    return;
  }
  $map = _jarvis_blocks_map();
  $bundle = $bc->bundle();
  if (empty($map[$bundle])) {
    return;
  }

  // Cacheability of the original build, plus anything the props pull in
  // (referenced files). Seeded from $content so block/entity cache tags still
  // bubble up.
  $cacheability = CacheableMetadata::createFromRenderArray($content);
  $props = _jarvis_blocks_props($bundle, $bc, $cacheability);

  // Replace the field-rendered body with the SDC render element.
  $component = [
    '#type' => 'component',
    '#component' => $map[$bundle],
    '#props' => $props,
  ];
  // Copy cacheability ONLY — never $content['#cache'] wholesale. That array
  // comes from EntityViewBuilder::getBuildDefaults() and carries #cache[keys]
  // and [bin], which name the block_content entity-view render-cache entry.
  // Reusing them wrote this SDC markup into that entry, so any other render
  // path for the same entity and view mode (a Views field, an entity-reference
  // formatter, Canvas field_display) would serve it back, or clobber it.
  $cacheability->applyTo($component);
  $variables['content'] = $component;
}

/**
 * Builds SDC props from a block_content entity's fields.
 */
function _jarvis_blocks_props(string $bundle, BlockContentInterface $bc, CacheableMetadata $cacheability): array {
  $has = static fn (string $f): bool => $bc->hasField($f) && !$bc->get($f)->isEmpty();
  $str = static fn (string $f): ?string => $has($f) ? (string) $bc->get($f)->value : NULL;
  $bool = static fn (string $f): bool => $has($f) ? (bool) $bc->get($f)->value : FALSE;
  $int = static fn (string $f): ?int => $has($f) ? (int) $bc->get($f)->value : NULL;

  $html = static function (string $f) use ($has, $bc): ?string {
    if (!$has($f)) {
      return NULL;
    }
    // Canvas's TextLongItemOverride drops the `processed` computed property,
    // so build the filter pipeline ourselves. #type processed_text rather than
    // check_markup(): the latter is deprecated in 11.4 and removed in 13, and
    // it renders in isolation, which silently discarded every cache tag the
    // filters produced (media embeds, linkit, token_filter). Plain render()
    // bubbles that metadata into the surrounding render context instead.
    $item = $bc->get($f)->first();
    $build = [
      '#type' => 'processed_text',
      '#text' => $item->value,
      '#format' => $item->format ?: NULL,
    ];
    return (string) \Drupal::service('renderer')->render($build);
  };

  $image = static function (string $f) use ($has, $bc, $cacheability): ?array {
    if (!$has($f)) {
      return NULL;
    }
    $item = $bc->get($f)->first();
    $file = $item->entity;
    if (!$file) {
      return NULL;
    }
    // Without the file's cache tag, replacing the image leaves the old URL in
    // the rendered page cache.
    $cacheability->addCacheableDependency($file);
    // Relative, not absolute: generateAbsoluteString() bakes the hostname into
    // cached markup, which breaks multi-domain and any environment served on a
    // different host than the one that primed the cache.
    $url = \Drupal::service('file_url_generator')->generateString($file->getFileUri());
    $out = ['src' => $url, 'alt' => (string) ($item->alt ?? '')];
    if (!empty($item->width)) {
      $out['width'] = (int) $item->width;
    }
    if (!empty($item->height)) {
      $out['height'] = (int) $item->height;
    }
    return $out;
  };

  $link = static function (string $f) use ($has, $bc): array {
    if (!$has($f)) {
      return [NULL, NULL];
    }
    $item = $bc->get($f)->first();
    try {
      $url = $item->getUrl()->toString();
    }
    catch (\Throwable $e) {
      // Don't fall back to the raw stored value — that emits the unrouted
      // internal:/foo or entity:node/1 string straight into an href.
      return [NULL, NULL];
    }
    return [$url, $item->title ?: NULL];
  };

  switch ($bundle) {
    case 'hero':
      [$cta_href, $cta_text] = $link('field_cta');
      return array_filter([
        'heading' => $str('field_heading'),
        'subheading' => $str('field_subheading'),
        'cta_text' => $cta_text,
        'cta_href' => $cta_href,
        'image' => $image('field_media_image'),
        'overlay' => $int('field_overlay') ?? 40,
        'align' => $str('field_align') ?? 'center',
      ], static fn ($v) => $v !== NULL);

    case 'card':
      [$link_href, $link_text] = $link('field_cta');
      return array_filter([
        'variant' => $str('field_variant') ?? 'image-top',
        'image' => $image('field_media_image'),
        'title' => $str('field_title'),
        'body' => $html('field_body'),
        'link_text' => $link_text,
        'link_href' => $link_href,
      ], static fn ($v) => $v !== NULL);

    case 'video':
      [$video_url] = $link('field_video_url');
      return array_filter([
        'video_url' => $video_url,
        'aspect' => $str('field_aspect') ?? '16x9',
        'full_width' => $bool('field_full_width'),
        'autoplay' => $bool('field_autoplay'),
        'muted' => $bool('field_muted'),
      ], static fn ($v) => $v !== NULL);

    case 'image':
      return array_filter([
        'image' => $image('field_media_image'),
        'caption' => $str('field_caption'),
        'full_width' => $bool('field_full_width'),
      ], static fn ($v) => $v !== NULL);

    case 'text':
      return array_filter([
        'body' => $html('field_body'),
        'width' => $str('field_width') ?? 'normal',
        'align' => $str('field_align') ?? 'start',
      ], static fn ($v) => $v !== NULL);
  }

  return [];
}
