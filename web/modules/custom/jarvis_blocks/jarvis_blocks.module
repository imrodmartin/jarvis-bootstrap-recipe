<?php

/**
 * @file
 * Renders Jarvis content block types through their matching SDCs.
 *
 * The implementation lives in src/Hook/JarvisBlocksHooks.php as an OOP hook.
 * Procedural hook discovery is removed in Drupal 12 and this module declares
 * core_version_requirement ^11 || ^12.
 *
 * Drupal 11 does not require a .module file; this one is retained only as a
 * signpost to where the code moved, and intentionally holds no logic.
 */

declare(strict_types=1);
