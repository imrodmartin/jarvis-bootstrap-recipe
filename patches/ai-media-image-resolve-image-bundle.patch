 /**
+ * Helper function to get the media type that stores uploaded images.
+ *
+ * The module used to hardcode the `image` bundle that the standard profile
+ * ships. Sites that namespace their media types (or renamed the stock one) then
+ * never got the Image Source dropdown at all, because neither the form id nor
+ * the bundle check ever matched. Resolve the bundle from the source plugin
+ * instead, preferring the conventional `image` id when it is present so nothing
+ * changes on a stock site.
+ *
+ * @return string|null
+ *   The media type id, or NULL when the site has no Image-source media type.
+ */
+function _ai_media_image_image_type_id() {
+  $candidates = [];
+  foreach (MediaType::loadMultiple() as $id => $media_type) {
+    if ($media_type->getSource()->getPluginId() === 'image') {
+      $candidates[$id] = $id;
+    }
+  }
+  if (isset($candidates['image'])) {
+    return 'image';
+  }
+  return $candidates ? reset($candidates) : NULL;
+}
+
+/**
  * Helper function to get the image field name for a given media type.
  */
 function _ai_media_image_get_image_field_name($media_type_id) {
-  $media_type = MediaType::load($media_type_id);
+  $media_type = $media_type_id ? MediaType::load($media_type_id) : NULL;
   if ($media_type) {
     return $media_type->getSource()->getSourceFieldDefinition($media_type)->getName();
   }
